// Windows resources for photo-stamp-screensaver.scr (compiled by build.rs with mingw's windres):
// the name Screen Saver Settings shows, the icon, the manifest and the settings dialog. The IDs
// are repeated in src/win/dialog.rs.
#include <windows.h>
#include <commctrl.h>

#ifndef VER_MAJOR
#define VER_MAJOR 0
#define VER_MINOR 0
#define VER_PATCH 0
#endif

#define IDD_SETTINGS 101
#define IDC_FOLDER 1001
#define IDC_BROWSE 1002
#define IDC_SECONDS 1003
#define IDC_SECONDS_SPIN 1004
#define IDC_URL 1005
#define IDC_KEY 1006
#define IDC_SHOWKEY 1007
#define IDC_TEST 1008
#define IDC_STATUS 1009
#define IDC_VERSION 1010
#define IDC_CAPTION 1011
#define IDC_CORNER 1012
#define IDC_ORDER 1013
#define IDC_CHANNEL 1014
#define IDC_UPDATES 1015

1 ICON "photo-stamp.ico"
1 24 "screensaver.manifest"

// String 1 is the name in Screen Saver Settings' list.
STRINGTABLE
BEGIN
    1 "Photo Stamp"
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
PRODUCTVERSION VER_MAJOR, VER_MINOR, VER_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Photo Stamp"
            VALUE "ProductName", "Photo Stamp screensaver"
            VALUE "OriginalFilename", "photo-stamp-screensaver.scr"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDD_SETTINGS DIALOGEX 0, 0, 300, 305
STYLE DS_SHELLFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_APPWINDOW
CAPTION "Photo Stamp screensaver"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    GROUPBOX        "Photos", -1, 7, 7, 286, 104
    LTEXT           "&Folder (its subfolders are included too):", -1, 15, 20, 270, 8
    EDITTEXT        IDC_FOLDER, 15, 31, 212, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "&Browse...", IDC_BROWSE, 231, 31, 54, 14
    LTEXT           "Show &each photo for", -1, 15, 52, 70, 8
    EDITTEXT        IDC_SECONDS, 86, 50, 36, 14, ES_NUMBER
    CONTROL         "", IDC_SECONDS_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS | UDS_NOTHOUSANDS, 0, 0, 0, 0
    LTEXT           "seconds", -1, 126, 52, 40, 8
    LTEXT           "Show &where and when", -1, 15, 72, 70, 8
    COMBOBOX        IDC_CAPTION, 86, 70, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_CORNER, 182, 70, 70, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Order", -1, 15, 92, 70, 8
    COMBOBOX        IDC_ORDER, 86, 90, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

    GROUPBOX        "Place server", -1, 7, 117, 286, 110
    LTEXT           "Where and when each photo was taken comes from the family's place server. Leave it empty to show photos without places.", -1, 15, 129, 270, 16
    LTEXT           "&Address:", -1, 15, 152, 48, 8
    EDITTEXT        IDC_URL, 66, 150, 219, 14, ES_AUTOHSCROLL
    LTEXT           "Device &key:", -1, 15, 171, 48, 8
    EDITTEXT        IDC_KEY, 66, 169, 179, 14, ES_AUTOHSCROLL | ES_PASSWORD
    AUTOCHECKBOX    "&Show", IDC_SHOWKEY, 251, 171, 34, 10
    PUSHBUTTON      "&Test connection", IDC_TEST, 66, 188, 70, 14
    LTEXT           "", IDC_STATUS, 66, 206, 219, 18

    GROUPBOX        "Updates", -1, 7, 233, 286, 48
    LTEXT           "&Install", -1, 15, 247, 48, 8
    COMBOBOX        IDC_CHANNEL, 66, 245, 90, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_UPDATES, 66, 263, 219, 16

    LTEXT           "", IDC_VERSION, 7, 287, 150, 8, WS_DISABLED
    DEFPUSHBUTTON   "OK", IDOK, 185, 284, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 243, 284, 50, 14
END
